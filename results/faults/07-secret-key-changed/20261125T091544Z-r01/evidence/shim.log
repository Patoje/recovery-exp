import base64, json, os, sys, urllib.error, urllib.request
sys.path.insert(0, "/work/pylib")
import gitea
s = json.load(open(sys.argv[1]))
auth = base64.b64encode((s["user"] + ":" + os.environ["SEED_USER_PASSWORD"]).encode()).decode()
req = urllib.request.Request("http://gitea:3000/api/v1/user",
                             headers={"Authorization": "Basic " + auth, "X-Gitea-OTP": gitea.totp(s["secret_base32"])})
try:
    print(urllib.request.urlopen(req, timeout=10).status)
except urllib.error.HTTPError as e:
    print(e.code)
