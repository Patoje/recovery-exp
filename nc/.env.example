# Valores de PRUEBA para el entorno de Nextcloud. Nada de esto es una credencial real.
# `nc/scripts/reset.sh` copia este archivo a nc/.env si nc/.env no existe.

# PostgreSQL: superusuario del servidor y usuario dedicado de Nextcloud (sin CREATEROLE, dueño de la
# base). Con un superusuario, el instalador de Nextcloud crea su propio rol (oc_<admin>), que no va en
# pg_dump y no existe en el servidor de la restauración.
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=test-pg-password
POSTGRES_DB=nextcloud
NC_DB_USER=nextcloud
NC_DB_PASSWORD=test-nc-db-password

# Restic
RESTIC_PASSWORD=test-restic-password

# Administrador de Nextcloud (lo crea la instalación en `up.sh`)
NC_ADMIN_USER=exp-admin
NC_ADMIN_PASSWORD=Test-Admin-Pass-1

# Datos de prueba
SEED=20261126
SEED_USER_PASSWORD=Test-User-Pass-1

# Línea base B0: usuario para el login y el listado de archivos
B0_USER=alice
B0_PASSWORD=Test-User-Pass-1

# Minutos entre el fin del backup y la hora del incidente T
INCIDENT_MINUTES=5
