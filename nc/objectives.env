# Objetivos declarados de recuperación (Nextcloud), mismas definiciones que objectives.env.
#
# RTO: desde el inicio de la restauración (restore_started_at) hasta que pasan las pruebas funcionales.
#   Mismo valor que en Gitea.
# RPO: hora del incidente T menos la hora del testigo más reciente recuperado (INCIDENT_MINUTES = 5).
RTO_SECONDS=120
RPO_SECONDS=600
