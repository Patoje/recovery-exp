# Valores de PRUEBA. Nada de esto es una credencial real.
# `make reset` copia este archivo a .env si .env no existe.

# PostgreSQL
POSTGRES_USER=gitea
POSTGRES_PASSWORD=test-pg-password
POSTGRES_DB=gitea

# Restic
RESTIC_PASSWORD=test-restic-password

# Administrador de Gitea (creado por `make up`)
GITEA_ADMIN_USER=exp-admin
GITEA_ADMIN_PASSWORD=Test-Admin-Pass-1
GITEA_ADMIN_EMAIL=exp-admin@example.test

# Datos de prueba
SEED=20261123
SEED_USER_PASSWORD=Test-User-Pass-1

# Línea base B0: usuario sin 2FA y repositorio a clonar
B0_USER=alice
B0_PASSWORD=Test-User-Pass-1
B0_CLONE_REPO=alice/notes

# Minutos entre el fin del backup y la hora del incidente T
INCIDENT_MINUTES=5

# MinIO (solo con MINIO=1)
MINIO_ROOT_USER=test-minio-user
MINIO_ROOT_PASSWORD=test-minio-password
MINIO_BUCKET=gitea
