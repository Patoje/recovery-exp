. "$FAULT_DIR/../lib/common.sh"
# Falla oculta D (docs/fallas-ocultas.md). Equivalencias en docs/fallas-ocultas/registro.md:
# proyecto orig = recexp, db = postgres, $OWNER/$REPO = alice/witness, host gitea-prod = gitea-original
# (el del procedimiento de referencia), backup-ref.sh = scripts/backup.sh.
T="$FAULT_EVIDENCE/testigos_d.json"
tj() { python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(eval("d"+sys.argv[2]))' "$T" "$1"; }

# 1. Testigos de la tanda $WID con un único push de un commit chico. S1 es el backup normal que sigue.
before_backup() {
  local n
  n="$(grep -o '"issue_number": [0-9]*' "$RUN_DIR/witnesses_pre.json" | head -1 | grep -o '[0-9]*$')"
  "${ORIG[@]}" --profile tools run --rm --no-deps -T runner python3 faults/O4-corrupcion-en-retencion/testigos.py "$n" > "$T"
}

after_backup() {
  local WID BLOB P UUID A s
  WID="$(tj '["wid"]')"
  json_field "$RUN_DIR/backup.json" id > "$FAULT_EVIDENCE/s1.txt"
  # 2. Corromper el blob testigo dentro del contenedor, como usuario git.
  BLOB=$("${ORIG[@]}" exec -T -u git gitea \
          git -C /data/git/repositories/alice/witness.git rev-parse "HEAD:testigo-$WID.txt") || return
  echo "$BLOB" > "$FAULT_EVIDENCE/blob.txt"
  P=/data/git/repositories/alice/witness.git/objects/${BLOB:0:2}/${BLOB:2}
  "${ORIG[@]}" exec -T -u git gitea sh -c "test -f $P && echo suelto || echo empaquetado" > "$FAULT_EVIDENCE/blob_loose.txt"
  "${ORIG[@]}" exec -T -u git gitea sh -c \
    "test -f $P && chmod u+w $P && printf '\377\377\377\377' | dd of=$P bs=1 seek=8 conv=notrunc 2>/dev/null && chmod a-w $P" || {
    echo "test -f falló: el objeto quedó empaquetado (ver blob_loose.txt)" >&2; return 1; }
  # 3. Corromper el adjunto testigo, mismo tamaño y contenido aleatorio, sin preservar el mtime.
  UUID=$("${ORIG[@]}" exec -T postgres sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "$1"' _ \
          "SELECT uuid FROM attachment WHERE name='testigo-$WID.bin'") || return
  A=/data/gitea/attachments/${UUID:0:1}/${UUID:1:1}/$UUID
  "${ORIG[@]}" exec -T -u git gitea sh -c "test -f $A && echo existe || echo no-existe" > "$FAULT_EVIDENCE/attachment_path.txt"
  "${ORIG[@]}" exec -T -u git gitea sh -c "sha256sum $A; stat -c '%s %Y' $A" > "$FAULT_EVIDENCE/attachment_before.txt"
  "${ORIG[@]}" exec -T -u git gitea sh -c \
    "head -c \$(stat -c%s $A) /dev/urandom > /tmp/x && cat /tmp/x > $A && rm /tmp/x" || return
  "${ORIG[@]}" exec -T -u git gitea sh -c "sha256sum $A; stat -c '%s %Y' $A" > "$FAULT_EVIDENCE/attachment_after.txt"
  # 4. Tres backups normales más (S2, S3, S4), cada uno con código 0.
  for s in 2 3 4; do
    mkdir -p "$RUN_DIR/cycle-$s"
    "$ROOT/scripts/backup.sh" "$RUN_DIR/cycle-$s" >> "$FAULT_EVIDENCE/backups_s2_s4.log" 2>&1; rc=$?
    echo "S$s backup.sh salió con $rc, snapshot $(json_field "$RUN_DIR/cycle-$s/backup.json" id)" >> "$FAULT_EVIDENCE/backups_s2_s4.txt"
    [ "$rc" -eq 0 ] || return "$rc"
    # Supuesto a verificar (mtime): qué cambió entre S1 y S2, antes de que la retención borre S1.
    [ "$s" = 2 ] && orig_restic diff "$(cat "$FAULT_EVIDENCE/s1.txt")" "$(json_field "$RUN_DIR/cycle-2/backup.json" id)" \
      > "$FAULT_EVIDENCE/restic_diff_s1_s2.txt"
  done
  # 5. Aplicar la retención.
  "${ORIG[@]}" --profile tools run --rm --no-deps restic forget --host gitea-original --keep-last 3 --prune \
    > "$FAULT_EVIDENCE/forget.log" 2>&1
}
