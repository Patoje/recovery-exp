#!/usr/bin/env bash
. "$FAULT_DIR/../lib/common.sh"
check "se creó el testigo con emoji" grep -q 'witness-emoji' "$FAULT_EVIDENCE/emoji_witness.json"
check "el dump se cargó sin --exit-on-error (shim)" grep -q 'pg_restore sin --exit-on-error' "$FAULT_SHIM_LOG"
enc="$(rest_sql 'show server_encoding')"
check "el PostgreSQL restaurado usa LATIN1 ($enc)" test "$enc" = LATIN1
check "pg_restore informó caracteres sin equivalente en LATIN1" grep -q 'has no equivalent in encoding "LATIN1"' "$FAULT_RUN_LOG"
observe "resumen de pg_restore" "$(grep -m1 'errors ignored on restore' "$FAULT_RUN_LOG")"
observe "código de salida de pg_restore en restore.json" "$(grep -o '"name":"pg_restore","status":"[a-z]*"[^}]*"exit_code":[0-9]*' "$RUN_DIR/restore.json" | grep -o '[0-9]*$')"
observe "filas en issue de la base restaurada" "$(rest_sql 'select count(*) from issue')"
# Supuesto a verificar: ¿arranca Gitea sobre esta base? (observación, no condiciona confirm)
if "${REST[@]}" up -d --wait --wait-timeout 120 gitea > "$FAULT_EVIDENCE/gitea_start_attempt.log" 2>&1; then
  observe "arranque de Gitea sobre la base LATIN1" "healthy; versión $("${REST[@]}" --profile tools run --rm --no-deps -T runner curl -s http://gitea:3000/api/v1/version 2>/dev/null)"
else
  observe "arranque de Gitea sobre la base LATIN1" "no llegó a healthy: $(docker logs --tail 5 "$("${REST[@]}" ps -aq gitea)" 2>&1 | tr '\n' ' ')"
fi
confirm_done
