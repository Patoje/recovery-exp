#!/usr/bin/env bash
# Shim de docker para escenarios de falla.
# Se antepone al PATH solo durante un escenario (nunca en 00-healthy). Reenvía todo al
# docker real y aplica las desviaciones que el escenario declara con variables FAULT_*.
# Cada modificación se registra en stderr (log de la corrida) y en $FAULT_SHIM_LOG.
#
#   FAULT_ORIG_OVERRIDE            -f extra para el proyecto original
#   FAULT_RESTORE_OVERRIDE         -f extra para el proyecto de restauración
#   FAULT_RESTORE_ENV_FILE         reemplaza --env-file en el proyecto de restauración
#   FAULT_RESTORE_UNSET_VARS       variables que se quitan del entorno en el proyecto de restauración
#   FAULT_RESTIC_BACKUP_EXTRA      argumentos agregados después de `restic backup`
#   FAULT_RESTIC_RESTORE_GLOBAL    argumentos globales agregados a restic en el proyecto de restauración
#   FAULT_STRIP_PG_RESTORE_EXIT    =1: quita --exit-on-error de pg_restore
#   FAULT_SKIP_GITEA_STOP          =1: `compose stop gitea` del proyecto original no hace nada
#   FAULT_EVENTS                   eventos habilitados: after_pg_dump after_restic_restore before_gitea_start
#                                  after_gitea_start (después de un `up -d --wait gitea` exitoso de la restauración)
set -u

REAL="${FAULT_REAL_DOCKER:?FAULT_REAL_DOCKER no definido}"

shim_log() {
  local line
  line="[shim] $(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
  printf '%s\n' "$line" >&2
  [ -n "${FAULT_SHIM_LOG:-}" ] && printf '%s\n' "$line" >> "$FAULT_SHIM_LOG"
}

event_enabled() { case " ${FAULT_EVENTS:-} " in *" $1 "*) return 0 ;; esac; return 1; }

fire_event() {
  shim_log "evento $1"
  bash -c '. "$FAULT_DIR/inject"; on_event "$1"' _ "$1" || { shim_log "evento $1 falló"; return 1; }
}

if [ "${1:-}" != "compose" ]; then
  exec "$REAL" "$@"
fi

orig=("$@")
project=""
case " $* " in
  *"/compose/restore.yml "*) project=restore ;;
  *"/compose/original.yml "*) project=original ;;
esac

args=()
unset_vars=()
modified=0
skip_next=""
i=0
n=$#
while [ "$i" -lt "$n" ]; do
  a="${orig[$i]}"
  if [ -n "$skip_next" ]; then skip_next=""; i=$((i + 1)); continue; fi
  case "$a" in
    */compose/restore.yml)
      args+=("$a")
      if [ -n "${FAULT_RESTORE_OVERRIDE:-}" ]; then args+=(-f "$FAULT_RESTORE_OVERRIDE"); modified=1; shim_log "restore: + -f $FAULT_RESTORE_OVERRIDE"; fi
      ;;
    */compose/original.yml)
      args+=("$a")
      if [ -n "${FAULT_ORIG_OVERRIDE:-}" ]; then args+=(-f "$FAULT_ORIG_OVERRIDE"); modified=1; shim_log "original: + -f $FAULT_ORIG_OVERRIDE"; fi
      ;;
    --env-file)
      if [ "$project" = restore ] && [ -n "${FAULT_RESTORE_ENV_FILE:-}" ]; then
        args+=(--env-file "$FAULT_RESTORE_ENV_FILE"); skip_next=1; modified=1
        shim_log "restore: --env-file ${orig[$((i + 1))]} -> $FAULT_RESTORE_ENV_FILE"
      else
        args+=("$a")
      fi
      ;;
    restic)
      args+=("$a")
      if [ "$project" = restore ] && [ -n "${FAULT_RESTIC_RESTORE_GLOBAL:-}" ]; then
        # shellcheck disable=SC2206
        extra=($FAULT_RESTIC_RESTORE_GLOBAL); args+=("${extra[@]}"); modified=1
        shim_log "restore: restic + $FAULT_RESTIC_RESTORE_GLOBAL"
      fi
      ;;
    backup)
      args+=("$a")
      if [ -n "${FAULT_RESTIC_BACKUP_EXTRA:-}" ] && printf '%s\n' "${orig[@]}" | grep -qx restic; then
        # shellcheck disable=SC2206
        extra=($FAULT_RESTIC_BACKUP_EXTRA); args+=("${extra[@]}"); modified=1
        shim_log "$project: restic backup + $FAULT_RESTIC_BACKUP_EXTRA"
      fi
      ;;
    *"pg_restore --exit-on-error "*)
      if [ "${FAULT_STRIP_PG_RESTORE_EXIT:-0}" = "1" ]; then
        args+=("${a/--exit-on-error /}"); modified=1
        shim_log "$project: pg_restore sin --exit-on-error"
      else
        args+=("$a")
      fi
      ;;
    *) args+=("$a") ;;
  esac
  i=$((i + 1))
done

if [ "$project" = restore ] && [ -n "${FAULT_RESTORE_UNSET_VARS:-}" ]; then
  for v in $FAULT_RESTORE_UNSET_VARS; do unset_vars+=(-u "$v"); done
  modified=1
  shim_log "restore: entorno sin $FAULT_RESTORE_UNSET_VARS"
fi

joined=" ${args[*]} "

# compose stop gitea del proyecto original
if [ "$project" = original ] && [ "${FAULT_SKIP_GITEA_STOP:-0}" = "1" ]; then
  case "$joined" in
    *" stop gitea "*) shim_log "original: 'stop gitea' omitido (Gitea sigue en marcha)"; exit 0 ;;
  esac
fi

if [ "$project" = restore ] && event_enabled before_gitea_start; then
  case "$joined" in
    *" up -d --wait gitea "*) fire_event before_gitea_start || exit 1 ;;
  esac
fi

[ "$modified" = 1 ] && shim_log "comando: docker ${args[*]}"

if [ ${#unset_vars[@]} -gt 0 ]; then
  env "${unset_vars[@]}" "$REAL" "${args[@]}"
else
  "$REAL" "${args[@]}"
fi
rc=$?
[ "$rc" -eq 0 ] || exit "$rc"

if [ "$project" = original ] && event_enabled after_pg_dump; then
  case "$joined" in
    *" exec "*"pg_dump "*) fire_event after_pg_dump || exit 1 ;;
  esac
fi
if [ "$project" = restore ] && event_enabled after_restic_restore; then
  case "$joined" in
    *" restic "*" restore "*) fire_event after_restic_restore || exit 1 ;;
  esac
fi
if [ "$project" = restore ] && event_enabled after_gitea_start; then
  case "$joined" in
    *" up -d --wait gitea "*) fire_event after_gitea_start || exit 1 ;;
  esac
fi
exit 0
