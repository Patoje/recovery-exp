#!/usr/bin/env bash
. "$FAULT_DIR/../lib/common.sh"
before="$FAULT_EVIDENCE/hooks_before_first_start.txt"
check "se inspeccionaron los hooks antes del primer arranque" grep -qx '# scan ok' "$before"
check "antes del primer arranque los hooks apuntaban a /usr/local/bin/gitea" grep -q '/usr/local/bin/gitea hook' "$before"
rest_gitea sh -c 'grep -h -o "^[^ ]*gitea hook" /data/git/repositories/*/*.git/hooks/*.d/gitea | sort | uniq -c' > "$FAULT_EVIDENCE/hooks_after_baseline.txt"
observe "hooks después de la línea base" "$(tr '\n' ' ' < "$FAULT_EVIDENCE/hooks_after_baseline.txt")"
check "los hooks siguen apuntando a /usr/local/bin/gitea (sin regenerar)" grep -q '/usr/local/bin/gitea hook' "$FAULT_EVIDENCE/hooks_after_baseline.txt"
check "/usr/local/bin/gitea no existe en el contenedor restaurado" fails "${REST[@]}" exec -T gitea test -e /usr/local/bin/gitea
exe="$(rest_gitea sh -c 'for p in /proc/[0-9]*; do e=$(readlink $p/exe 2>/dev/null); case "$e" in */gitea) echo "$e"; break;; esac; done')"
check "el Gitea en marcha es /opt/gitea/bin/gitea ($exe)" test "$exe" = /opt/gitea/bin/gitea
docker logs "$("${REST[@]}" ps -aq gitea)" 2>&1 | grep -i -E 'hook' | head -5 > "$FAULT_EVIDENCE/gitea_log_hooks.txt"
observe "log de Gitea sobre hooks" "$(tr '\n' ' ' < "$FAULT_EVIDENCE/gitea_log_hooks.txt")"
confirm_done
