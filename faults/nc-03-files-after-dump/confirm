#!/usr/bin/env bash
. "$FAULT_DIR/../lib/nc/common.sh"
L="$FAULT_EVIDENCE/late_files.json"
check "se subieron archivos después de pg_dump" grep -q '"path": "late/' "$L"
p="$(json_field "$L" path)"
insnap="$(snap_ls /data/alice/files/late | grep -c "^/data/alice/files/$p$")"
check "el snapshot contiene $p en disco ($insnap)" test "$insnap" -eq 1
dump_filecache > "$FAULT_EVIDENCE/dump_filecache.txt"
indump="$(grep -c $'\tfiles/late' "$FAULT_EVIDENCE/dump_filecache.txt")"
check "el dump (base restaurada) no conoce ningún archivo de late/ ($indump)" test "$indump" -eq 0
ctl="$(grep -c $'\tfiles/Documents/documents-00.txt\t' "$FAULT_EVIDENCE/dump_filecache.txt")"
check "el dump se pudo leer (control: Documents/documents-00.txt = $ctl)" test "$ctl" -ge 1
observe "filas de late/ en la base restaurada en marcha (después de la línea base)" "$(rest_sql "select count(*) from oc_filecache f join oc_storages s on s.numeric_id = f.storage where s.id = 'home::alice' and f.path like 'files/late/%'")"
ondisk="$(rest_nc sh -c "test -f /var/www/html/data/alice/files/$p && echo sí || echo no")"
check "el archivo está en el disco restaurado ($ondisk)" test "$ondisk" = sí
confirm_done
