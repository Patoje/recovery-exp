NAME="Repositorio de Restic en solo lectura en los ciclos 2 y 3 (cron sin código de salida)"
# Los testigos posteriores corren 35 minutos desde el ciclo 1; T = ciclo 1 + 35 min.
# Con el repositorio en solo lectura, cada ciclo fallido tarda ~14 min (restic reintenta el lock)
# y el ciclo 3 empieza apenas termina el 2; 35 min deja los tres ciclos antes de T.
FAULT_INCIDENT_MINUTES=35
